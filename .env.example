# ── WAQI (World Air Quality Index) — required ───────────
# Free token: https://aqicn.org/data-platform/token/
WAQI_TOKEN=your_waqi_token_here

# Cities to ingest (comma-separated). The 88 cities in ingestion/waqi_client.py
# CITY_BOUNDS get every station in their bounding box; any other name falls back
# to WAQI's single city feed. If unset, run_pipeline.py defaults to:
# Delhi,London,Beijing,Seoul,Jakarta,Mumbai,Paris,Tokyo,New York,Chicago
WAQI_CITIES=Delhi,London,Beijing,Seoul,Jakarta,Mumbai,Paris,Tokyo,New York,Chicago

# ── PostgreSQL (local — installed via Homebrew) ──────────
# On Mac with Homebrew Postgres, no password is needed by default.
# Username = your Mac username (run: whoami in terminal)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=airquality
POSTGRES_USER=your_mac_username_here
POSTGRES_PASSWORD=

# ── dbt ─────────────────────────────────────────────────
DBT_PROFILES_DIR=./dbt

# ── OpenAQ v3 — optional ────────────────────────────────
# Only used by the optional OpenAQ client/Airflow DAG; run_pipeline.py does not need it.
# Free API key from https://openaq.org/register
OPENAQ_API_KEY=your_openaq_api_key_here
OPENAQ_CITIES=Los Angeles,New York,Chicago,Houston,Phoenix
